gel-jira.atlassian.net/wiki" data-linked-resource-content-type=3D"image/png=
" data-linked-resource-container-id=3D"73302505" data-linked-resource-conta=
iner-version=3D"31" data-media-id=3D"e6d213b6-d045-4bc9-b108-402aa48cd912" =
data-media-type=3D"file" height=3D"135"></span>
