      expected_label: "Firefox"
    - appLineId: 370
      appVersionId: null
      expected_label: "Edge"
    - appLineId: 437
      appVersionId: null
      expected_label: "zoom"

# =========================
# STEP 18 PROFILE VERSION CHANGE
# =========================
profile_app_versions:
  apps:
    - app_id: 442
      name: chromium
      downgrade:
        version_id: 651
        expected_label: chromium-142.0.7444+1
      upgrade:
        version_id: 637
        expected_label: chromium-142.0.7444+2

    - app_id: 479
      name: firefox
      downgrade:
        version_id: 695
        expected_label: firefox-140.3.0+1
      upgrade:
        version_id: 698
        expected_label: firefox-140.5.0+1

    - app_id: 370
      name: edge
      downgrade:
        version_id: 419
        expected_label: edge-141.0.3537+1
      upgrade:
        version_id: 1075
        expected_label: edge-143.0.3650+1

    - app_id: 437
      name: zoom
      downgrade:
        version_id: 1029
        expected_label: zoom-6.5.8+1
      upgrade:
        version_id: 1439
        expected_label: zoom-6.7.2+1

